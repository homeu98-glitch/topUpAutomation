{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://macau-ledger.vercel.app https://macau-pos-system.vercel.app http://localhost:3000 http://127.0.0.1:3000"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/auto-approve",
      "schedule": "0 0 * * *"
    }
  ]
}
